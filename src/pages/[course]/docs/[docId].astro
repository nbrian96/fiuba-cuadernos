---
import { getCollection, render } from "astro:content";
import DocLayout from "@/layouts/DocLayout.astro";
import { buildMaterialViewerUrl, withBase } from "@/utils/paths";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  const courseById = new Map(courses.map((c) => [c.data.id, c.data]));
  const allDocs = await getCollection("docs");
  const resourceManifests = await getCollection("resources");

  const resourcesByCourse = new Map<
    string,
    Map<string, { resourceId: string; title: string; hasPdf: boolean }>
  >();
  for (const manifest of resourceManifests) {
    const map =
      resourcesByCourse.get(manifest.data.courseId) ?? new Map();
    for (const res of manifest.data.resources) {
      map.set(res.resourceId, {
        resourceId: res.resourceId,
        title: res.title,
        hasPdf: Boolean(res.pdfMetadata),
      });
    }
    resourcesByCourse.set(manifest.data.courseId, map);
  }

  const docsByCourse = new Map<string, typeof allDocs>();
  for (const doc of allDocs) {
    const list = docsByCourse.get(doc.data.courseId) ?? [];
    list.push(doc);
    docsByCourse.set(doc.data.courseId, list);
  }
  for (const list of docsByCourse.values()) {
    list.sort((a, b) => a.data.order - b.data.order);
  }

  return allDocs
    .filter((entry) => courseById.has(entry.data.courseId))
    .map((entry) => {
      const course = courseById.get(entry.data.courseId)!;
      const orderedDocs = docsByCourse.get(entry.data.courseId) ?? [];
      const idx = orderedDocs.findIndex(
        (item) => item.data.docId === entry.data.docId,
      );
      const prevEntry = idx > 0 ? orderedDocs[idx - 1] : null;
      const nextEntry =
        idx >= 0 && idx < orderedDocs.length - 1 ? orderedDocs[idx + 1] : null;

      const resMap = resourcesByCourse.get(entry.data.courseId) ?? new Map();
      const relatedResources = (entry.data.relatedResourceIds ?? [])
        .map((id) => resMap.get(id))
        .filter((r): r is NonNullable<typeof r> => Boolean(r));

      return {
        params: {
          course: entry.data.courseId,
          docId: entry.data.docId,
        },
        props: {
          entry,
          course,
          prevDoc: prevEntry
            ? { docId: prevEntry.data.docId, title: prevEntry.data.title }
            : null,
          nextDoc: nextEntry
            ? { docId: nextEntry.data.docId, title: nextEntry.data.title }
            : null,
          relatedResources,
        },
      };
    });
}

const { entry, course, prevDoc, nextDoc, relatedResources } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocLayout
  course={course}
  doc={entry.data}
  headings={headings}
  prevDoc={prevDoc}
  nextDoc={nextDoc}
  breadcrumbs={[
    { label: "Hub de materias", href: withBase("/") },
    { label: course.shortTitle, href: withBase(`/${course.id}/`) },
    { label: entry.data.title },
  ]}
>
  <Content />

  {
    relatedResources.length > 0 ? (
      <section aria-label="Materiales de referencia" style="margin-top: 1.5rem;">
        <h2>Materiales de referencia</h2>
        <ul>
          {relatedResources.map((res) => (
            <li>
              <a
                href={buildMaterialViewerUrl(
                  course.id,
                  res.resourceId,
                  res.hasPdf ? 1 : undefined,
                )}
              >
                {res.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }
</DocLayout>
