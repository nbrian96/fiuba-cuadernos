---
import { getCollection } from "astro:content";
import CourseLayout from "@/layouts/CourseLayout.astro";
import ExerciseFilterHUD from "@/components/platform/ExerciseFilterHUD";
import {
  sortCourseExercises,
  toExerciseFilterItems,
  type ExerciseFilterItem,
} from "@/utils/exerciseFilters";
import { withBase } from "@/utils/paths";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((course) => ({
    params: { course: course.data.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const courseId = course.data.id;

const exercises = sortCourseExercises(
  await getCollection("exercises", (entry) => entry.data.courseId === courseId),
);

const filterItems: ExerciseFilterItem[] = toExerciseFilterItems(
  courseId,
  exercises,
  course.data.units,
);

const unitOptions = course.data.units
  .slice()
  .sort((a, b) => a.order - b.order)
  .map((u) => ({ slug: u.slug, name: u.name }));
---

<CourseLayout
  course={course.data}
  title={`Ejercicios — ${course.data.shortTitle}`}
  description={`Catálogo filtrable de ejercicios de ${course.data.title}`}
  activeSection="exercises"
  breadcrumbs={[
    { label: "Hub de materias", href: withBase("/") },
    { label: course.data.shortTitle, href: withBase(`/${courseId}/`) },
    { label: "Ejercicios" },
  ]}
>
  <header style="margin-bottom: 1.25rem;">
    <h1>Catálogo de ejercicios</h1>
    <p style="margin: 0; color: var(--text-muted);">
      Filtrá por modo de estudio, dificultad, unidad temática, condición de
      parcial real o palabra clave. El progreso marcado se conserva en este
      navegador.
    </p>
  </header>

  <ExerciseFilterHUD
    client:load
    courseId={courseId}
    exercises={filterItems}
    units={unitOptions}
  />
</CourseLayout>
