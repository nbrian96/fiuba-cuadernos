---
import { getCollection } from "astro:content";
import CourseLayout from "@/layouts/CourseLayout.astro";
import QuickRecognitionTrainer from "@/components/platform/QuickRecognitionTrainer";
import ProvenanceBadge from "@/components/platform/ProvenanceBadge";
import { sortCourseExercises } from "@/utils/exerciseFilters";
import { buildMaterialViewerUrl, withBase } from "@/utils/paths";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((course) => ({
    params: { course: course.data.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const courseId = course.data.id;

const resourceManifests = await getCollection(
  "resources",
  (entry) => entry.data.courseId === courseId,
);
const assessmentManifests = await getCollection(
  "assessments",
  (entry) => entry.data.courseId === courseId,
);
const quizzes = await getCollection(
  "quizzes",
  (entry) => entry.data.courseId === courseId,
);
const exercises = sortCourseExercises(
  await getCollection("exercises", (entry) => entry.data.courseId === courseId),
);
const hasAvanzados = course.data.units.some((u) => u.slug === "avanzados");
const featuredExercises = [
  ...exercises.filter((e) => e.data.isParcial).slice(0, 6),
  ...exercises.filter((e) => e.data.entityType === "AdvancedTheoryExercise"),
];
const docs = (
  await getCollection("docs", (entry) => entry.data.courseId === courseId)
).sort((a, b) => a.data.order - b.data.order);

const totalResources = resourceManifests.reduce(
  (acc, item) => acc + item.data.resources.length,
  0,
);
const totalExams = assessmentManifests.reduce(
  (acc, item) => acc + item.data.exams.length,
  0,
);
const totalPracticalWorks = assessmentManifests.reduce(
  (acc, item) => acc + item.data.practicalWorks.length,
  0,
);
const allCourseResources = resourceManifests.flatMap(
  (item) => item.data.resources,
);
const firstPdfResource =
  allCourseResources.find((res) => Boolean(res.pdfMetadata)) ??
  allCourseResources[0];
const sampleMaterialUrl = firstPdfResource
  ? buildMaterialViewerUrl(courseId, firstPdfResource.resourceId, 1)
  : withBase(`/${courseId}/materiales/`);

const primaryQuiz = quizzes[0]?.data ?? null;
---

<CourseLayout
  course={course.data}
  title={`${course.data.title} — ${course.data.institution}`}
  description={`Panel principal de ${course.data.title} (${course.data.chair})`}
  activeSection="overview"
  breadcrumbs={[
    { label: "Hub de materias", href: withBase("/") },
    { label: course.data.shortTitle },
  ]}
>
  <header style="margin-bottom: 1.5rem;">
    <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted);">
      {course.data.institution} · {course.data.codes.join(" / ")} ·{" "}
      {course.data.chair}
    </p>
    <h1 style="margin: 0.35rem 0 0.5rem;">{course.data.title}</h1>

    <div class="stat-grid" aria-label="Indicadores de la materia">
      <div class="stat-card">
        <div class="stat-value">{course.data.stats.catalogExercises}</div>
        <div class="stat-label">Ejercicios de catálogo</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{course.data.stats.parcialExercises}</div>
        <div class="stat-label">Ejercicios de parciales</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{course.data.stats.physicalFiles}</div>
        <div class="stat-label">Archivos de material</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{course.data.stats.pdfs}</div>
        <div class="stat-label">Documentos PDF</div>
      </div>
    </div>
  </header>

  <section class="surface-panel" aria-label="Accesos principales de la materia">
    <h2 style="margin-top: 0;">Espacios de estudio</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
      <a class="btn btn-primary" href={withBase(`/${courseId}/ejercicios/`)}>
        Explorar ejercicios ({exercises.length} cargados)
      </a>
      <a class="btn" href={withBase(`/${courseId}/parciales/`)}>
        Parciales y evaluaciones ({totalExams})
      </a>
      {
        hasAvanzados ? (
          <a class="btn" href={withBase(`/${courseId}/avanzados/`)}>
            Teoría Avanzada y Simuladores
          </a>
        ) : null
      }
      <a class="btn" href={withBase(`/${courseId}/materiales/`)}>
        Repositorio de materiales ({totalResources} recursos)
      </a>
      <a class="btn" href={sampleMaterialUrl}>
        Abrir visor de PDFs
      </a>
      {
        docs[0] ? (
          <a
            class="btn"
            href={withBase(`/${courseId}/docs/${docs[0].data.docId}/`)}
          >
            {docs[0].data.title}
          </a>
        ) : null
      }
    </div>
    <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted);">
      Evaluaciones registradas: <strong>{totalExams}</strong> parciales y{" "}
      <strong>{totalPracticalWorks}</strong> bloques de trabajos prácticos.
    </p>
  </section>

  {
    primaryQuiz ? (
      <div style="margin-top: 1.5rem;">
        <QuickRecognitionTrainer client:load quiz={primaryQuiz} />
      </div>
    ) : null
  }

  <section class="surface-panel" aria-label="Ejercicios destacados en plataforma" style="margin-top: 1.5rem;">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
      <h2 style="margin: 0;">Ejercicios en plataforma ({exercises.length})</h2>
      <a class="btn" href={withBase(`/${courseId}/ejercicios/`)}>
        Ver catálogo completo ({exercises.length})
      </a>
    </div>
    <ul class="plain-list">
      {
        featuredExercises.map((ex) => (
          <li style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;">
            <ProvenanceBadge provenance={ex.data.provenance} />
            <a href={withBase(`/${courseId}/ejercicios/${ex.data.id}/`)}>
              {ex.data.number !== null
                ? `Ejercicio ${ex.data.number}: ${ex.data.title}`
                : ex.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="surface-panel" aria-label="Apuntes y resúmenes">
    <h2 style="margin-top: 0;">Apuntes y resúmenes ({docs.length})</h2>
    <ul class="plain-list">
      {
        docs.map((doc) => (
          <li style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;">
            <ProvenanceBadge provenance={doc.data.provenance} />
            <a href={withBase(`/${courseId}/docs/${doc.data.docId}/`)}>
              {doc.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="surface-panel" aria-label="Unidades de la materia">
    <h2 style="margin-top: 0;">
      Unidades académicas ({course.data.units.length})
    </h2>
    <ul class="card-grid" style="list-style: none; padding: 0; margin: 0;">
      {
        course.data.units
          .slice()
          .sort((a, b) => a.order - b.order)
          .map((unit) => {
            const unitHref = unit.inCatalog
              ? withBase(`/${courseId}/unidad/${unit.slug}/`)
              : withBase(`/${courseId}/avanzados/`);
            return (
              <li class="stat-card">
                <a href={unitHref} style="font-weight: 700;">
                  {unit.order}. {unit.name}
                </a>
                <div style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem;">
                  <code>{unit.slug}</code> · {unit.exerciseCount} ej.
                </div>
              </li>
            );
          })
      }
    </ul>
  </section>
</CourseLayout>
