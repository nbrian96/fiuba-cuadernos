{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/vitest/**/*.ts",
    "tests/vitest/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules", "builder", "Practicas", "TP0"]
}
